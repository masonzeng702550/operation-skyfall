# Copy to .env and edit before deploying.

# Which challenge the scorer and dashboard are configured for: q0 | q2 | q3
CHALLENGE=q3

# Flag for this instance. Use a per-team value in a real event.
FLAG=THJCC{set_a_real_flag_before_you_deploy_this}

# Shared secret between the scorer and the dashboard. Rotate per deployment.
SOLVE_TOKEN=change-me-per-deployment

# Published ports
TAP_PORT=14580
VIZ_PORT=8080
MAVLINK_PORT=14550

# Simulator build. Q2 depends on an unpatched tree — do not move this.
ARDUPILOT_BRANCH=Copter-4.6.3
ARDUPILOT_TAG=4.6.3
