# Copy to .env and edit before deploying.

# --- flag issuing -----------------------------------------------------------
# static:  every instance serves the same string. Fine for practice, a local
#          range, or a writeup — and useless the moment one team pastes it
#          into a group chat.
# dynamic: derived per team from FLAG_SECRET + TEAM_ID, so a leaked flag
#          names the team that leaked it and submitting someone else's fails.
FLAG_MODE=static

# static mode. Leave empty to use the built-in default.
FLAG=

# dynamic mode. FLAG_SECRET must never reach a container the players can read.
FLAG_SECRET=
TEAM_ID=solo

# Shared secret between the scorer and the dashboard. Rotate per deployment.
SOLVE_TOKEN=change-me-per-deployment

# Published ports. The simulator's MAVLink port is intentionally not among them.
TAP_PORT=14580
VIZ_PORT=8080

# Simulator build.
ARDUPILOT_BRANCH=Copter-4.6.3
ARDUPILOT_TAG=4.6.3
